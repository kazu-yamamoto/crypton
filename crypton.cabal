    other-modules:
        Crypto.Cipher.AES.Primitive
        Crypto.Cipher.Blowfish.Primitive
        Crypto.Cipher.Camellia.Primitive
        Crypto.Cipher.CAST5.Primitive
        Crypto.Cipher.DES.Primitive
